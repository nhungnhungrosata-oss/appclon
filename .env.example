# Required. Use: npm run setup
APP_PASSWORD=
SESSION_SECRET=

# Fish Creative Lip Sync uses its website; no Lip Sync API key is used here.
# Add only the provider keys you want to enable.
FISH_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Model IDs verified against official docs on 2026-09-19.
# Fish model is hardcoded to s2.1-pro-free; no paid fallback exists.
FISH_FREE_UNTIL=2026-11-30
GOOGLE_MODEL=gemini-2.5-flash-lite
DEEPSEEK_MODEL=deepseek-flash
OPENAI_MODEL=gpt-5.4-mini

# Recommended for production; mandatory when more than one account exists.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_USERS_JSON={}

# Attempt limits per UTC day, including failed upstream requests.
DAILY_TEXT_LIMIT=30
DAILY_ANALYSIS_LIMIT=15
DAILY_TTS_LIMIT=30
DAILY_UPLOAD_LIMIT=40
GLOBAL_TEXT_LIMIT=300
GLOBAL_ANALYSIS_LIMIT=150
GLOBAL_TTS_LIMIT=300
GLOBAL_UPLOAD_LIMIT=400
