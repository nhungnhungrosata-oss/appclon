# Authentication
APP_PASSWORD=
SESSION_SECRET=

# Vbee AIVoice API
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Endpoint can be changed if your Vbee API application uses another base URL.
VBEE_API_BASE_URL=https://vbee.vn/api/v1

# AI providers
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite
DEEPSEEK_MODEL=deepseek-flash
OPENAI_MODEL=gpt-5.4-mini

# Required for multi-user quota + admin voice assignment on Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional additional accounts (seed users 01-10 already exist as password hashes)
APP_USERS_JSON={}

DAILY_TEXT_LIMIT=30
DAILY_ANALYSIS_LIMIT=15
DAILY_TTS_LIMIT=30
DAILY_UPLOAD_LIMIT=40
GLOBAL_TEXT_LIMIT=300
GLOBAL_ANALYSIS_LIMIT=150
GLOBAL_TTS_LIMIT=300
GLOBAL_UPLOAD_LIMIT=400
